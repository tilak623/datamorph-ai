# DataMorph AI Environment Configuration

# Session Security (32+ character random string)
SESSION_SECRET=datamorph_dev_secret_key_32chars_long_minimum!

# GitHub OAuth App (Register at https://github.com/settings/developers)
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI Provider Keys (Optional - built-in deterministic query engine operates without external keys)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Base URL (for production deployments, e.g. https://datamorph.onrender.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Database URL (PostgreSQL for production; falls back to embedded JSON store if empty)
DATABASE_URL=
